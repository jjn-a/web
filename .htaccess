# PHP Session Configuration
php_value session.save_path "/Applications/XAMPP/xamppfiles/htdocs/Projekt/sessions"
php_value session.cookie_path "/"
php_value session.cookie_httponly 1
php_value session.use_cookies 1
php_value session.use_only_cookies 1
php_value session.auto_start 0
php_value session.cookie_samesite "Lax"

# Session file permissions - make them world-readable so both CLI and web server can access
php_value session.gc_probability 1
php_value session.gc_divisor 100
php_value session.gc_maxlifetime 1440
php_value session.save_mode 0666

# Increase memory limit for dashboard
php_value memory_limit 128M

# Increase max execution time
php_value max_execution_time 300

# Enable error logging
php_flag display_errors Off
php_value error_log /Applications/XAMPP/xamppfiles/htdocs/Projekt/error.log

# Security headers
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set X-XSS-Protection "1; mode=block"
</IfModule>

